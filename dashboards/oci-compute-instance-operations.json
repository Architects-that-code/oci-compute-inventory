              "signal": 2
            },
            "renameByName": {
              "region": "Region",
              "compartment_path": "Compartment",
              "signal": "Signal"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "enablePagination": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Region"
          }
        ]
      }
    }

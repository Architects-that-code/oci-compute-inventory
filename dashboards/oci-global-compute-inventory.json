{
  "uid": "oci-global-compute-inventory",
  "title": "OCI / Global Running Compute",
  "schemaVersion": 41,
  "version": 3,
  "description": "Tenancy-wide Compute API inventory, refreshed every five minutes after each completed scan. All READY subscribed regions and ACTIVE compartments (including the tenancy root) are paginated. RUNNING VMs and bare-metal instances count regardless of metrics-agent state. Scan results are observations made during a scan, not a transactional OCI snapshot. A failure suppresses all count series; freshness/coverage panels remain visible. Counts do not represent CPU, OCPU, DB services or container/pod counts.",
  "tags": [
    "oci",
    "inventory",
    "compute",
    "global",
    "terraform"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(oci_compute_inventory_region_success, region)",
        "definition": "label_values(oci_compute_inventory_region_success, region)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      },
      {
        "name": "compartment",
        "label": "Compartment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(oci_compute_compartment_info, compartment_path)",
        "definition": "label_values(oci_compute_compartment_info, compartment_path)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Running Compute instances",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Compute API lifecycle_state=RUNNING. Includes VM, bare metal, managed OKE and Karpenter workers across the entire tenancy. Filters apply. Counts are hidden if a scan is incomplete or older than three configured poll intervals. No telemetry-emitting-agent requirement.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(oci_compute_running_instances{region=~\"$region\",compartment_path=~\"$compartment\"}) and on() ((oci_compute_inventory_collection_success == 1) and (time() - oci_compute_inventory_last_success_timestamp_seconds < 3 * oci_compute_inventory_poll_interval_seconds))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Regions with running compute",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Active regions within the selected region and compartment filters, out of the full number of discovered subscribed regions. Both numbers come from the collector. Suppressed when inventory is stale or incomplete.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.active_regions} of ${__field.labels.total_regions}",
          "noValue": "Inventory unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count_values(\"active_regions\", ((count((sum by (region) ((oci_compute_running_instances{job=\"oci-compute-inventory\",region=~\"$region\",compartment_path=~\"$compartment\"} and on (job,instance) (((oci_compute_inventory_collection_success{job=\"oci-compute-inventory\"} == 1) and on (job,instance) ((time() - oci_compute_inventory_last_success_timestamp_seconds{job=\"oci-compute-inventory\"}) < 3 * oci_compute_inventory_poll_interval_seconds{job=\"oci-compute-inventory\"})) and on (job,instance) topk(1,oci_compute_inventory_last_success_timestamp_seconds{job=\"oci-compute-inventory\"}))))) > 0) or vector(0)) and on () (max((((oci_compute_inventory_collection_success{job=\"oci-compute-inventory\"} == 1) and on (job,instance) ((time() - oci_compute_inventory_last_success_timestamp_seconds{job=\"oci-compute-inventory\"}) < 3 * oci_compute_inventory_poll_interval_seconds{job=\"oci-compute-inventory\"})) and on (job,instance) topk(1,oci_compute_inventory_last_success_timestamp_seconds{job=\"oci-compute-inventory\"})))))) * on () group_left(total_regions) count_values(\"total_regions\", max(oci_compute_inventory_regions_expected{job=\"oci-compute-inventory\"} and on (job,instance) topk(1,oci_compute_inventory_last_success_timestamp_seconds{job=\"oci-compute-inventory\"})))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Inventory collection success",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "0 means counts must not be trusted; 1 means the last whole-tenancy attempt succeeded. Independent of selected filters.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "oci_compute_inventory_collection_success",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
